    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
