# Database: Supabase PostgreSQL (Connection Pooler URL)
# Port 6543 (Transaction Mode) atau 5432 (Session Mode)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase (untuk media storage)
# Project URL + anon/service key dari dashboard Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=media

# Admin seed (dipakai oleh src/db/seed.ts)
ADMIN_EMAIL=admin@marketingcode.id
ADMIN_PASSWORD=ubah-password-ini
ADMIN_NAME=Admin

# WhatsApp Contact (Untuk integrasi CTA dinamis)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
