# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (marketingcode.id)
# Salin file ini menjadi .env atau .env.local untuk local development
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# 2. PUBLIC SITE DOMAIN URL (Canonical URLs, Sitemap, OpenGraph)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 3. WHATSAPP BUSINESS CONTACT (Format internasional tanpa +)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# 4. S3 OBJECT STORAGE (Neon Storage / Cloudflare R2 / AWS S3)
AWS_ENDPOINT_URL_S3=https://your-s3-endpoint.storage.aws.neon.tech
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-southeast-1
S3_BUCKET=marketingcodeid

# 5. GOOGLE ANALYTICS 4 (Opsional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 6. INITIAL ADMIN CREDENTIALS (Untuk pnpm db:seed)
ADMIN_EMAIL=admin@marketingcode.id
ADMIN_PASSWORD=admin-password-here
ADMIN_NAME=Admin

# 7. CONTENT BEHAVIOR (0 = Database Mode, 1 = Offline Demo Sample Data)
CONTENT_DEMO_MODE=0
