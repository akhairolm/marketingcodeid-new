# Database: Supabase PostgreSQL (Connection Pooler URL)
# Port 6543 (Transaction Mode) atau 5432 (Session Mode)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Payload CMS Secret (Generate a strong random string)
PAYLOAD_SECRET=your-super-strong-random-payload-secret

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase Storage S3-Compatible API (Opsional jika mengaktifkan @payloadcms/storage-s3)
S3_ENDPOINT=https://[PROJECT-REF].supabase.co/storage/v1/s3
S3_BUCKET=media
S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
S3_REGION=ap-southeast-1

# WhatsApp Contact (Untuk integrasi CTA dinamis)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

